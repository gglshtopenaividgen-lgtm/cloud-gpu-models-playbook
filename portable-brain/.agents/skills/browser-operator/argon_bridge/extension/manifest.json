{
  "manifest_version": 3,
  "name": "Browser operator",
  "version": "1.0.0",
  "description": "Ultra-fast local WebSocket & CDP bridge connecting Antigravity to authentic user Chrome profiles without guest mode.",
  "permissions": [
    "debugger",
    "tabs",
    "activeTab",
    "scripting",
    "storage",
    "identity",
    "identity.email",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "*://*/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "icons": {
    "48": "icon.png"
  }
}
